# Copy to .env.local and fill in your own Neon connection string:
#   cp .env.example .env.local
#
# Get it from the Neon console -> your project -> "Connect to your database".
# The pooled (-pooler) host is fine: the app and the ETL both use the HTTP
# driver (neon() from @neondatabase/serverless), so each query is an HTTPS
# request and Postgres-level pooling is moot. If `drizzle-kit push` hangs or
# errors, retry with the direct (non-pooler) host, since it opens a real TCP
# connection for DDL.
#
# .env.local is gitignored. Never commit the real credential -- this repo is public.
DATABASE_URL="postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<database>?sslmode=require"
